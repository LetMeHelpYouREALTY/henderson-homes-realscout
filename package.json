{
  "name": "henderson-homes-realscout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "next build && next-sitemap",
    "build:cloudflare": "cross-env NEXT_BUILD_TARGET=cloudflare next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "fix": "biome check --write . && biome format --write .",
    "analyze": "ANALYZE=true next build",
    "export": "next build && next export",
    "vercel-build": "npm run build:vercel",
    "cloudflare-build": "npm run build:cloudflare",
    "deploy:cloudflare": "npm run cloudflare:build && wrangler deploy",
    "cloudflare:worker": "wrangler dev --local",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:tail": "wrangler tail",
    "cloudflare:secret": "wrangler secret put",
    "precommit": "biome check --write . && biome format --write .",
    "optimize-images": "node scripts/optimize-images.js",
    "setup-images": "mkdir -p public/images/{photos/{agents,clients,events},properties/{featured,sold,virtual-tours},neighborhoods,team,logos,icons}"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@vercel/analytics": "^1.3.0",
    "@vercel/speed-insights": "^1.0.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3"
  }
}
